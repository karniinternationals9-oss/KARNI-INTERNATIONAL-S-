# Copy this file to ".env" for local testing with `netlify dev`.
# On Netlify: Site configuration > Environment variables. NEVER commit real keys.
# Use rzp_test_... keys for testing and rzp_live_... keys after Razorpay activates your account.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
